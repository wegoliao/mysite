[["01","我創造我的人生","我主動經營父子情","父子情壓在我身上"],["02","玩金錢遊戲的目的","經營為彼此成就","維持只為不衝突"],["03","行動 vs 空想","用行動走近父親","空想父子親密"],["04","格局大小","立志讓父驕傲","只求不丟臉"],["05","專注焦點","專注父的教導","只看父的缺失"],["06","對成功的態度","真心欣賞父親","以父為恥"],["07","交往對象","結交正向榜樣","與怨恨者為伍"],["08","表達自我","坦誠向父表達","覺得父不懂而沉默"],["09","面對問題","超越父子創傷","被創傷定義"],["10","接受能力","坦然接受父愛","自認不配"],["11","計酬方式","看重親密程度","只看同住時間"],["12","選擇思維","做自己且孝順","為孝放棄自我"],["13","衡量財富","看整體關係品質","只看父給資源"],["14","管理金錢","主動管理互動","等到父老才聯繫"],["15","賺錢方式","建立默契傳統","單方面苦撐"],["16","面對恐懼","怕否定仍表達","怕父反應而隱藏"],["17","學習態度","學做好兒子","自認沒什麼好學"]]