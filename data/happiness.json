[["01","我創造我的人生","我創造我的幸福","幸福取決於外界"],["02","玩金錢遊戲的目的","追求幸福豐盛","只求不要痛苦"],["03","行動 vs 空想","用行動創造幸福","空想幸福降臨"],["04","格局大小","有遠大幸福願景","只求小確幸"],["05","專注焦點","專注幸福機會","專注不幸原因"],["06","對成功的態度","欣賞幸福的人","嫉妒幸福的人"],["07","交往對象","與幸福者為伍","與哀怨者互憐"],["08","表達自我","樂於表達喜悅","壓抑感受"],["09","面對問題","大於幸福障礙","被不幸吞噬"],["10","接受能力","欣然接受幸福","自認不配"],["11","計酬方式","看重幸福品質","只看擁有多少"],["12","選擇思維","兼顧當下與未來","只顧眼前或只等未來"],["13","衡量財富","看整體幸福感","只看單一成就"],["14","管理金錢","管理情緒與幸福","放任情緒流失"],["15","賺錢方式","建立幸福習慣","每天苦撐"],["16","面對恐懼","怕失敗仍追求","因怕而不敢要"],["17","學習態度","學習幸福之道","自認知道幸福"]]